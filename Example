"script.js": r'''document.addEventListener("DOMContentLoaded",()=>{
  const toggle=document.getElementById("chatToggle"), win=document.getElementById("chatWindow"), close=document.getElementById("chatClose");
  if(toggle) toggle.onclick=()=>win.classList.toggle("open");
  if(close) close.onclick=()=>win.classList.remove("open");
  const messages=document.getElementById("chatMessages"), form=document.getElementById("chatForm"), input=document.getElementById("chatInput");
  function reply(q){
    const x=q.toLowerCase();
    if(x.includes("what is cashmask")) return "CashMask is a research portal for examining socio-technical security risks created by monetisation, chance and reward mechanics in online games.";
    if(x.includes("loot")) return "A loot box is a game mechanic where a player receives an uncertain digital reward. CashMask treats uncertainty and monetary input as observable risk signals.";
    if(x.includes("risk")) return "The prototype uses observable signals such as monetary input, chance, repeated attempts and cash-linked pathways. The final project taxonomy determines the formal classification.";
    if(x.includes("t0")||x.includes("t6")) return "The prototype uses T0–T6 as increasing taxonomy tiers, from no monetary interaction through stronger combinations of monetary, chance and cash-linked signals.";
    if(x.includes("kappa")||x.includes("cohen")) return "Cohen's kappa can be used to measure agreement between coders beyond chance when classifying the same set of games.";
    if(x.includes("method")) return "The workflow is collect → code → compare → evaluate. The project can use a coding manual and inter-rater reliability measures to test consistency.";
    if(x.includes("monetary")) return "Monetary input means the player spends real money or purchased currency in connection with a game mechanic or reward.";
    if(x.includes("chance")) return "Chance matters because an uncertain outcome can make the value received unpredictable. In CashMask, chance is one signal considered alongside monetary exposure and other mechanics.";
    return "I can explain CashMask, the T0–T6 taxonomy, monetary input, chance-based rewards, the methodology, or the prototype risk checker.";
  }
  function add(text,cls){const d=document.createElement("div");d.className=cls;d.textContent=text;messages.appendChild(d);messages.scrollTop=messages.scrollHeight}
  if(form) form.addEventListener("submit",e=>{e.preventDefault();const q=input.value.trim();if(!q)return;add(q,"user");input.value="";setTimeout(()=>add(reply(q),"bot"),300)});
  document.querySelectorAll(".quick button").forEach(b=>b.addEventListener("click",()=>{if(input){input.value=b.dataset.q;form.dispatchEvent(new Event("submit",{cancelable:true}))}}));

  const risk=document.getElementById("riskForm");
  if(risk) risk.addEventListener("submit",e=>{
    e.preventDefault();
    let score=0;
    ["money","chance","repeat","cash"].forEach(n=>{const el=document.querySelector(`input[name="${n}"]:checked`);if(el)score+=Number(el.value)});
    const game=document.getElementById("gameName").value.trim();
    let level,title,desc;
    if(score===0){level="T0";title="LOW / NO MONETARY SIGNAL";desc="No monetary or chance-based risk signals were observed in this prototype assessment."}
    else if(score<=2){level="T1–T2";title="LOW–MODERATE ATTENTION";desc="The game presents some monetary or uncertainty signals. Further evidence should be collected before classification."}
    else if(score<=4){level="T3–T4";title="ELEVATED ATTENTION";desc="Multiple monetisation and/or chance signals are present. The game's player journey warrants closer analysis."}
    else {level="T5–T6";title="HIGH ATTENTION";desc="The assessment combines several strong signals, including a possible cash-linked pathway. This is a research flag, not a legal determination."}
    document.getElementById("resultCard").innerHTML=`<div class="result"><p class="eyebrow">ANALYSIS COMPLETE · ${game.toUpperCase()}</p><div class="score">${score}<small style="font-size:18px;color:#6d8587"> / 7</small></div><div class="level">${level}</div><h2>${title}</h2><p>${desc}</p><div class="bars"><div>Monetary exposure<div class="bar"><i style="width:${document.querySelector('input[name="money"]:checked').value*100}%"></i></div></div><div>Chance / uncertainty<div class="bar"><i style="width:${document.querySelector('input[name="chance"]:checked').value*50}%"></i></div></div><div>Cash-linked pathway<div class="bar"><i style="width:${document.querySelector('input[name="cash"]:checked').value*33}%"></i></div></div></div></div>`;
  });
});'''
}

